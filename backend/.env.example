# ─────────────────────────────────────────────────────────────
# Groundr backend — environment variables
# Copy to backend/.env and fill in. NEVER commit .env.
#
# Names here must match backend/config/settings.py exactly — anything
# that does not match a Settings field is silently ignored.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Any value other than development/dev/local enables the boot guards
# in settings.validate_for_boot().
APP_ENV=development
DEBUG=true

# JWT signing key. Must be >=32 chars when APP_ENV is not development.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Comma-separated CORS allowlist. "*" is refused outside development
# because a wildcard with credentials is invalid per the CORS spec.
FRONTEND_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# Defaults match docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groundr
DB_USER=groundr
DB_PASSWORD=groundr123

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── External APIs ────────────────────────────────────────────
# PDOK/BAG, OpenStreetMap/Overpass and CBS OData are free and keyless.
PDOK_BASE_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1
ALTUM_AI_API_KEY=
KADASTER_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────
# Leave empty to skip sending rather than fail.
RESEND_API_KEY=
FROM_EMAIL=noreply@groundr.nl
FRONTEND_URL=http://localhost:3000

# ── Scraping ─────────────────────────────────────────────────
SCRAPER_DELAY_SECONDS=3.0
SCRAPER_MAX_RETRIES=3

# ── Analytics ────────────────────────────────────────────────
DEFAULT_RADIUS_KM=2.0
MIN_RADIUS_KM=0.5
MAX_RADIUS_KM=10.0
